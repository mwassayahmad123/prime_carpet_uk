<section id="home" class="hero">
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <p class="hero__eyebrow">{{serviceAreaText}}</p>
    <h1 class="hero__title">
      London's Trusted Carpet &amp;<br />
      <span>Upholstery Steam Cleaning</span>
    </h1>
    <p class="hero__subtitle">
      Professional steam cleaning for carpets, sofas, rugs, mattresses, and upholstery.
      Book a free consultation and see why homeowners across London trust us.
    </p>
    <div class="hero__actions">
      <a href="#contact" class="btn btn--primary btn--lg js-nav-link">Get a Free Quote</a>
