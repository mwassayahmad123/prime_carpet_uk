      <a href="#services" class="btn btn--outline btn--lg js-nav-link">Our Services</a>
    </div>
    <div class="hero__stats">
      <div class="hero__stat">
        <strong>500+</strong>
        <span>Carpets Cleaned</span>
      </div>
      <div class="hero__stat">
        <strong>10+</strong>
        <span>Years Experience</span>
      </div>
      <div class="hero__stat">
        <strong>5.0</strong>
        <span>Customer Rating</span>
      </div>
    </div>
  </div>
</section>
