<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__col footer__brand">
      <a href="/" class="footer__logo js-nav-link">
        {{> logo}}
      </a>
      <p>Professional carpet &amp; upholstery steam cleaning. Book your free consultation today.</p>
      <p class="footer__area">📍 {{serviceAreaText}}</p>
      <div class="footer__social">
        <a href="{{contact.facebook}}" class="footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h4 class="footer__col-title">Quick Links</h4>
      <nav class="footer__nav">
        {{#each navLinks}}
          <a href="{{this.href}}" class="js-nav-link">{{this.label}}</a>
        {{/each}}
      </nav>
    </div>

    <div class="footer__col">
      <h4 class="footer__col-title">Services</h4>
      <nav class="footer__nav">
        {{#each servicesNav}}
          <a href="/services/{{this.slug}}/">{{this.name}}</a>
        {{/each}}
      </nav>
    </div>

    <div class="footer__col">
      <h4 class="footer__col-title">Contact</h4>
      <nav class="footer__nav">
        <a href="tel:{{contact.phoneHref}}">{{contact.phone}}</a>
        <a href="https://wa.me/{{contact.whatsappHref}}" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
        <a href="mailto:{{contact.email}}">{{contact.email}}</a>
      </nav>
    </div>
  </div>
  <div class="footer__bottom">
    <div class="container">
      <p>&copy; {{currentYear}} {{companyName}}. All rights reserved.</p>
    </div>
  </div>
</footer>
