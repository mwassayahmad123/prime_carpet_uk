<section id="blog" class="section blog-highlights">
  <div class="container">
    <div class="section__header">
      <p class="section__eyebrow">From the Blog</p>
      <h2 class="section__title">Cleaning Tips &amp; Advice</h2>
      <p class="section__text section__text--center">
        Practical guides on stain removal, carpet care, and upholstery cleaning from our team.
      </p>
    </div>
    <div class="blog-slider js-blog-slider">
      <div class="blog-slider__viewport">
        <div class="blog-slider__track js-blog-slider-track">
          {{#each blogHighlights}}
            <div class="blog-slider__slide">
              {{> blog-card}}
            </div>
          {{/each}}
        </div>
      </div>
      <button type="button" class="blog-slider__arrow blog-slider__arrow--prev js-blog-slider-prev" aria-label="Previous articles">‹</button>
      <button type="button" class="blog-slider__arrow blog-slider__arrow--next js-blog-slider-next" aria-label="Next articles">›</button>
    </div>
    <div class="blog-highlights__cta">
      <a href="/blog/" class="btn btn--outline btn--lg">View All Articles →</a>
    </div>
  </div>
</section>
